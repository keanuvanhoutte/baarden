{
  "rules": {
    "rooms": {
      ".read": true,
      ".write": true
    },
    "spelers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "xp": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "partijen": {
          "$soort": { ".validate": "($soort === 'gespeeld' || $soort === 'gewonnen' || $soort === 'verloren' || $soort === 'gelijk') && newData.isNumber() && newData.val() >= 0" }
        },
        "aangemaakt": { ".validate": "newData.isNumber()" },
        "bijgewerkt": { ".validate": "newData.isNumber()" },
        "$anders": { ".validate": false }
      }
    }
  }
}
